## Carving: signature scan with validation

`binwalk` is very noisy on Go binaries — the pclntab and type metadata throw constant false hits. A validating scanner is much better because it tries the actual decompression and discards anything that fails:

```python
import re, zlib, gzip, bz2, lzma, io, pefile

data = open("sample.exe","rb").read()

MAGICS = {
    b"PK\x03\x04":            "zip",
    b"\x1f\x8b\x08":          "gzip",
    b"BZh":                   "bzip2",
    b"\xfd7zXZ\x00":          "xz",
    b"\x28\xb5\x2f\xfd":      "zstd",
    b"\x04\x22\x4d\x18":      "lz4",
    b"7z\xbc\xaf\x27\x1c":    "7z",
    b"MSCF":                  "cab",
    b"MZ":                    "pe",
    b"\x7fELF":               "elf",
    b"\x89PNG\r\n\x1a\n":     "png",
    b"%PDF":                  "pdf",
    b"SQLite format 3\x00":   "sqlite",
    b"\x78\x9c":              "zlib",   # noisy
    b"\x78\xda":              "zlib",
    b"\x78\x01":              "zlib",
}

def try_decomp(kind, buf):
    try:
        if kind == "zlib":  return zlib.decompressobj().decompress(buf)
        if kind == "gzip":  return gzip.GzipFile(fileobj=io.BytesIO(buf)).read()
        if kind == "bzip2": return bz2.BZ2Decompressor().decompress(buf)
        if kind == "xz":    return lzma.LZMADecompressor().decompress(buf)
    except Exception:
        return None
    return b""   # container formats: treat magic as sufficient

for magic, kind in MAGICS.items():
    for m in re.finditer(re.escape(magic), data):
        off = m.start()
        out = try_decomp(kind, data[off:off+0x400000])
        if out is None:
            continue
        print(f"{kind:8} @ 0x{off:08x}  decompressed={len(out)}")
```

Two refinements that cut noise a lot:

- Ignore `MZ` hits that aren't followed by a valid `e_lfanew` pointing at `PE\0\0`.
- For zlib, require the two-byte header to pass the checksum rule: `(b[0]*256 + b[1]) % 31 == 0`. That alone kills most of the false positives.

